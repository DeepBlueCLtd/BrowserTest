# Sonar Quiz System Environment Variables

# Instructor password hash (SHA-256 or better)
# Generate with: echo -n "your-password" | shasum -a 256
# IMPORTANT: Use a strong password (min 8 characters)
VITE_INSTRUCTOR_PASSWORD_HASH=changeme

# Feature flags (optional)
# VITE_ENABLE_ENCRYPTION=true
# VITE_ENABLE_RATE_LIMIT=true
# VITE_ENABLE_SECURITY_LOGS=false
