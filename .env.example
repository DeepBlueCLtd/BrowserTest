# Sonar Quiz System - Environment Configuration
#
# Copy this file to .env and configure with your values
# NEVER commit .env to version control

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Instructor Password Hash (SHA-256)
# Generate using: echo -n "your-password" | openssl dgst -sha256
# Example output: abc123def456... (64 characters)
#
# IMPORTANT:
# - Use a strong, unique password
# - Hash it BEFORE adding to this file
# - Never commit the plaintext password
# - Change the default password on first deployment
#
VITE_INSTRUCTOR_PASSWORD_HASH=

# =============================================================================
# DEBUG CONFIGURATION
# =============================================================================

# Enable debug logging (true/false)
# - true: Detailed console logs for development
# - false: Silent mode for production (only errors)
#
# IMPORTANT: ALWAYS set to false in production
#
VITE_DEBUG=true

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Generate instructor password hash:
#    echo -n "your-strong-password" | openssl dgst -sha256
#
# 3. Add the hash to VITE_INSTRUCTOR_PASSWORD_HASH above
#
# 4. Set VITE_DEBUG=false for production builds
#
# 5. Verify configuration:
#    npm run build
#    # Should succeed without errors
#
# 6. Test instructor unlock:
#    - Open demo/quiz-index.html in browser
#    - Log in as student
#    - Click instructor panel
#    - Enter your password (NOT the hash)
#    - Should unlock successfully
#
# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# - The hash is embedded in the bundle at build time
# - Use environment-specific .env files for different deployments
# - Rotate passwords regularly
# - Consider implementing password change on first use
# - For production, use a password manager to generate strong passwords
#
# Example strong password characteristics:
# - At least 16 characters
# - Mix of uppercase, lowercase, numbers, symbols
# - Not based on dictionary words
# - Unique to this application
#
# =============================================================================
