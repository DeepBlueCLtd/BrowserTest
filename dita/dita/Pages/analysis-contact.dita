<?xml version="1.0" encoding="UTF-8"?>
<topic id="analysis-contact" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:oasis:names:tc:dita:xsd:topic.xsd">
    <title>Contact Classification Analysis</title>
    <body>
        <p>Students analyze sonar contacts and fill in classification details.</p>
        <note type="note">Gray cells (with background-color) are read-only. White cells are editable. Your entries are auto-saved.</note>
        <p>
            <simpletable frame="all" relcolwidth="0.75* 0.75* 1.0* 0.75* 1.25*" outputclass="qd-analysis">
                <sthead>
                    <stentry>Contact ID</stentry>
                    <stentry>Bearing (°)</stentry>
                    <stentry>Classification</stentry>
                    <stentry>Confidence</stentry>
                    <stentry>Notes</stentry>
                </sthead>
                <strow>
                    <stentry>C-001</stentry>
                    <stentry>045</stentry>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>C-002</stentry>
                    <stentry>120</stentry>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>C-003</stentry>
                    <stentry>270</stentry>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>C-004</stentry>
                    <stentry>315</stentry>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                    <stentry outputclass="interactive"/>
                </strow>
            </simpletable>
        </p>
        <section>
            <title>Verification Questions</title>
            <p>Based on your analysis above, answer the following questions:</p>
            <p>
                <simpletable frame="all" relcolwidth="2.5* 0.5* 1.5*" outputclass="qd-quiz">
                    <sthead>
                        <stentry>Question</stentry>
                        <stentry>Answer</stentry>
                        <stentry>Detail</stentry>
                    </sthead>
                    <strow>
                        <stentry>How many contacts did you classify as merchant vessels?</stentry>
                        <stentry>2</stentry>
                        <stentry>0.5</stentry>
                    </strow>
                    <strow>
                        <stentry>Which contact has the highest confidence level?</stentry>
                        <stentry>1</stentry>
                        <stentry>
                            <ol>
                                <li>C-001</li>
                                <li>C-002</li>
                                <li>C-003</li>
                                <li>C-004</li>
                            </ol>
                        </stentry>
                    </strow>
                    <strow>
                        <stentry>What is the bearing of the contact classified as submarine?</stentry>
                        <stentry>270</stentry>
                        <stentry>5</stentry>
                    </strow>
                </simpletable>
            </p>
        </section>
    </body>
</topic>
