<?xml version="1.0" encoding="UTF-8"?>
<topic id="gram1-2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:oasis:names:tc:dita:xsd:topic.xsd">
    <title>Gram Analysis 3</title>
    <body>
        <p>Advanced spectrogram analysis exercise. Analyze multiple contacts and environmental conditions.</p>
        <section id="section_r1z_rym_bgc">
            <title>Gram</title>
            <table frame="all" rowsep="1" colsep="1" id="table_uyb_bym_bgc"
                outputclass="gram-config">
                <tgroup cols="2" align="center">
                    <colspec colname="c1" colnum="1" colwidth="1*"/>
                    <colspec colname="c2" colnum="2" colwidth="1*"/>
                    <tbody>
                        <row>
                            <entry namest="c1" nameend="c2">
                                <image placement="break" href="images/mock-gram-large.png" align="center"
                                    id="image_svr_dym_bgc"/>
                            </entry>
                        </row>
                        <row>
                            <entry>time-start</entry>
                            <entry>0</entry>
                        </row>
                        <row>
                            <entry>time-end</entry>
                            <entry>40</entry>
                        </row>
                        <row>
                            <entry>freq-start</entry>
                            <entry>100</entry>
                        </row>
                        <row>
                            <entry>freq-end</entry>
                            <entry>300</entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="section_zmv_tym_bgc">
            <title>Comprehensive Analysis</title>
            <p>Complete your comprehensive analysis based on the spectrogram above:</p>
            <simpletable frame="all" relcolwidth="1.5* 3.0*" outputclass="qd-analysis">
                <strow>
                    <stentry>Number of distinct contacts:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Primary contact classification:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Secondary contact classification:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Environmental noise assessment:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Doppler shift observations:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Tactical recommendation:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
            </simpletable>
        </section>
    </body>
</topic>
