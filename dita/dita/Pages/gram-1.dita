<?xml version="1.0" encoding="UTF-8"?>
<topic id="Untitled" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:oasis:names:tc:dita:xsd:topic.xsd">
    <title>Gram Analysis 1</title>
    <body>
        <p>Analyze the spectrogram below and complete your analysis in the table.</p>
        <div id="section_r1z_rym_bgc">
            <table frame="all" rowsep="1" colsep="1" id="table_uyb_bym_bgc"
                outputclass="gram-config">
                <tgroup cols="2" align="center">
                    <colspec colname="c1" colnum="1" colwidth="1*"/>
                    <colspec colname="c2" colnum="2" colwidth="1*"/>
                    <tbody>
                        <row>
                            <entry namest="c1" nameend="c2">
                                <image placement="break" href="images/gram-1.png" align="center"
                                    id="image_svr_dym_bgc"/>
                            </entry>
                        </row>
                        <row>
                            <entry>time-start</entry>
                            <entry>0</entry>
                        </row>
                        <row>
                            <entry>time-end</entry>
                            <entry>40</entry>
                        </row>
                        <row>
                            <entry>freq-start</entry>
                            <entry>100</entry>
                        </row>
                        <row>
                            <entry>freq-end</entry>
                            <entry>300</entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </div>
        <div id="questions">
            <p>Complete your analysis based on the spectrogram above:</p>
            <simpletable frame="all" relcolwidth="1.5* 3.0*" outputclass="qd-analysis">
                <strow>
                    <stentry>What is dominant source?</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Frequency range (Hz):</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Signal characteristics:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Environmental factors considered:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Confidence level:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
            </simpletable>
        </div>
    </body>
</topic>
