<?xml version="1.0" encoding="UTF-8"?>
<topic id="analysis-tactical" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:oasis:names:tc:dita:xsd:topic.xsd">
    <title>Tactical Decision Matrix</title>
    <body>
        <p>Students record their tactical analysis decisions based on a given scenario.</p>
        <note type="note">This analysis table is designed for recording tactical decisions. Fill in your recommendations and justifications.</note>
        <p>
            <simpletable frame="all" relcolwidth="1.5* 3.0*" outputclass="qd-analysis">
                <strow>
                    <stentry>Threat Assessment:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Recommended Action:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Course Change (if any):</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Speed Change (if any):</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Sonar Mode Selection:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
                <strow>
                    <stentry>Justification:</stentry>
                    <stentry outputclass="interactive"/>
                </strow>
            </simpletable>
        </p>
        <section>
            <title>Verification Questions</title>
            <p>Based on your tactical analysis above, answer the following:</p>
            <p>
                <simpletable frame="all" relcolwidth="2.5* 0.5* 1.5*" outputclass="qd-quiz">
                    <sthead>
                        <stentry>Question</stentry>
                        <stentry>Answer</stentry>
                        <stentry>Detail</stentry>
                    </sthead>
                    <strow>
                        <stentry>What threat level did you assign?</stentry>
                        <stentry>2</stentry>
                        <stentry>
                            <ol>
                                <li>Low</li>
                                <li>Medium</li>
                                <li>High</li>
                                <li>Critical</li>
                            </ol>
                        </stentry>
                    </strow>
                    <strow>
                        <stentry>What is your recommended course change in degrees?</stentry>
                        <stentry>45</stentry>
                        <stentry>10</stentry>
                    </strow>
                </simpletable>
            </p>
        </section>
    </body>
</topic>
